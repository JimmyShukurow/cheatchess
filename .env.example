# LOCAL DEVELOPMENT config: copy to .env (gitignored).
# Production config is generated by Ansible from deploy/ansible/group_vars/all/{vars,vault}.yml
BASE_URL=http://localhost:8080

# Optional: Google login. Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/api/auth/google/callback (and your prod domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get the engine "Best move" button.
# The email must be verified: sign in with Google once, or run on the server:
#   ./cheatchess verify-email you@example.com          (prod: sudo cheatchess-cli verify-email …)
ADMIN_EMAILS=
